        4 function random_lineages(n; depth=8, branching=3)
        2     lineages = Dict{String,Vector{String}}()
        2     state = UInt64(12345)
      322     next_int(k) = (state = state * 6364136223846793005 + 1442695040888963407; Int((state >> 33) % k) + 1)
        2     for i in 1:n
       52         len = next_int(depth - 1) + 1
       52         path = [next_int(branching) for _ in 1:len]
       52         lineages["t$(i)"] = vcat(["Biota"], ["N" * join(path[1:d]) for d in 1:len])
      102     end
        2     return lineages
        - end
